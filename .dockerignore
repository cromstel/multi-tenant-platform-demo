# Keep the build context small and the image reproducible.
# Anything not needed to build and run the app is excluded.

.git
.github
.next
node_modules
coverage
tests
mockups

# Local environment files — secrets must never enter the image.
.env
.env.local
.env.*.local
!.env.example

# Editor and OS noise
.vscode
.idea
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docs that do not ship
README.md
SECURITY.md
AGENTS.md
CLAUDE.md

# Local key/value store — must not ship
.dev-store.json
