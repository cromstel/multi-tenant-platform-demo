# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
#   cp .env.example .env.local
#
# No port is hardcoded anywhere in this project — every port below is read from
# this file at startup. Change `PORT` and you must change the port inside
# `NEXT_PUBLIC_ROOT_DOMAIN` to match (see the note there).
# ---------------------------------------------------------------------------

# Port the Next.js server listens on. Honoured by `pnpm dev` and `pnpm start`.
PORT=3131

# Upstash Redis credentials — used in production and on Vercel.
# Create a free database at https://console.upstash.com/ then copy the
# REST API URL and token from the "REST API" section of the dashboard.
# Leave BOTH blank to run locally against the built-in file-backed store
# (data is persisted to `.dev-store.json` and git-ignored).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The root domain that serves the landing page and admin panel.
# Tenants are then reachable at `{subdomain}.{NEXT_PUBLIC_ROOT_DOMAIN}`.
#
#   local:  localhost:3131   and   http://{subdomain}.localhost:3131
#   prod:   platforms.example.com  and  https://{subdomain}.platforms.example.com
#
# In production omit the scheme and the port (or use :443):
#   NEXT_PUBLIC_ROOT_DOMAIN=platforms.example.com
#
# Why the port is repeated instead of reused from `PORT`: browsers resolve
# `*.localhost` to the loopback interface but take the port from the hostname
# itself. `NEXT_PUBLIC_ROOT_DOMAIN=localhost` would send every tenant to
# http://{subdomain}.localhost/ on port 80, not to the dev server.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3131

# Optional: where the local development store writes its data file.
# Defaults to `<project-root>/.dev-store.json`.
# LOCAL_KV_FILE=.dev-store.json

# ---------------------------------------------------------------------------
# Admin access — REQUIRED to reach /admin
#
# Both values must be set or /admin denies every request (it fails closed).
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ---------------------------------------------------------------------------

# The admin password. Compared in constant time against the submitted value.
# Use a long, random, unique password and store it in your secret manager.
ADMIN_PASSWORD=

# Random string (32+ characters) used to sign the session cookie with HS256.
# Rotating it invalidates every existing admin session immediately.
ADMIN_SESSION_SECRET=