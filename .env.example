# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
#   cp .env.example .env.local
#
# No port is hardcoded anywhere in this project — every port below is read from
# this file at startup. Change `PORT` and you must change the port inside
# `NEXT_PUBLIC_ROOT_DOMAIN` to match (see the note there).
# ---------------------------------------------------------------------------

# Port the Next.js server listens on. Honoured by `pnpm dev` and `pnpm start`.
PORT=3030

# ---------------------------------------------------------------------------
# Database Configuration (MySQL 8 / MariaDB 10.6+)
# ---------------------------------------------------------------------------
# The schema is created automatically on first use — every table is issued
# with CREATE TABLE IF NOT EXISTS, so an empty database is enough to start.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=multi_tenant_admin
MYSQL_PASSWORD=
MYSQL_DATABASE=multi_tenant

# Upstash Redis credentials — optional. Only needed if you want to swap the
# counter store away from MySQL. Leave BOTH blank to use the MySQL-backed
# `kv_store` table.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The root domain that serves the landing page and admin panel.
# Tenants are then reachable at `{subdomain}.{NEXT_PUBLIC_ROOT_DOMAIN}`.
#
#   local:  localhost:3030   and   http://{subdomain}.localhost:3030
#   prod:   platforms.example.com  and  https://{subdomain}.platforms.example.com
#
# In production omit the scheme and the port (or use :443):
#   NEXT_PUBLIC_ROOT_DOMAIN=platforms.example.com
#
# Why the port is repeated instead of reused from `PORT`: browsers resolve
# `*.localhost` to the loopback interface but take the port from the hostname
# itself. `NEXT_PUBLIC_ROOT_DOMAIN=localhost` would send every tenant to
# http://{subdomain}.localhost/ on port 80, not to the dev server.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3030

# Optional: where the local development store writes its data file.
# Defaults to `<project-root>/.dev-store.json`.
# LOCAL_KV_FILE=.dev-store.json

# ---------------------------------------------------------------------------
# Admin Access — REQUIRED to reach the admin area
#
# All four values must be set or the admin area denies every request (it
# fails closed).
#
# ADMIN_PATH is the unguessable public path segment. While it is set:
#   - /{ADMIN_PATH}          → admin sign in
#   - /{ADMIN_PATH}/dashboard → admin dashboard
#   - /auth/admin            → 404 (the internal path stays hidden)
# The admin area is also unlinked from every public page and marked noindex.
# Generate a path with:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# ---------------------------------------------------------------------------

# Public path segment for the admin area. Keep it unguessable.
ADMIN_PATH=

# Email of the site administrator account. Created on first sign-in if it
# does not exist yet.
ADMIN_EMAIL=admin@yourcompany.com

# The admin password. Compared in constant time against the submitted value.
# Use a long, random, unique password and store it in your secret manager.
ADMIN_PASSWORD=

# Random string (32+ characters) used to sign the session cookie with HS256.
# Rotating it invalidates every existing admin session immediately.
ADMIN_SESSION_SECRET=

# Optional: Separate secret for tenant sessions (falls back to ADMIN_SESSION_SECRET)
TENANT_SESSION_SECRET=

# ---------------------------------------------------------------------------
# API Access — REQUIRED to use the JSON API with a machine key
#
# The admin dashboard uses the session cookie, so it needs no key. Integrations
# and scripts do. Format: `name:secret` pairs, comma-separated.
#
#   API_KEYS=integrations:sk_live_xxx,monitoring:sk_live_yyy
#
# Send the secret as `Authorization: Bearer <secret>` or `x-api-key: <secret>`.
# Leave blank to disable machine-key access entirely — the cookie path still
# works.
#
# Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------
API_KEYS=

# ---------------------------------------------------------------------------
# Tenant Creation Limits
# ---------------------------------------------------------------------------
# Number of tenants that can be created per IP per hour
# TENANT_CREATE_LIMIT=10
