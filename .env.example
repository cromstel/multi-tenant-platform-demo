# =============================================================================
# CITGROUP TENANCY SYSTEM — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values before running the app.
# Required variables must be set; optional ones have sensible defaults.
# =============================================================================

# =============================================================================
# Database
# =============================================================================

# MySQL server hostname. Required.
MYSQL_HOST=localhost

# MySQL server port. Required.
MYSQL_PORT=3306

# MySQL username. Required.
MYSQL_USER=root

# MySQL password. Required.
MYSQL_PASSWORD=your_mysql_password

# MySQL database name. Required.
MYSQL_DATABASE=multi_tenant

# =============================================================================
# Authentication & Sessions
# =============================================================================

# Secret used to sign and verify tenant JWT sessions (jose HS256).
# Must be at least 32 characters. Required.
AUTH_JWT_SECRET=your-32-char-jwt-secret-here

# Secret used to sign admin session cookies. Must be at least 32 characters.
# Required.
ADMIN_SESSION_SECRET=your-32-char-admin-session-secret-here

# Fallback secret for tenant sessions when TENANT_SESSION_SECRET is not set.
# Must be at least 32 characters. Optional (falls back to ADMIN_SESSION_SECRET).
TENANT_SESSION_SECRET=your-32-char-tenant-session-secret-here

# =============================================================================
# Admin
# =============================================================================

# Email of the bootstrap super-admin account. Required.
ADMIN_EMAIL=admin@citgroup.example

# Password of the bootstrap super-admin account. Required.
ADMIN_PASSWORD=your-secure-admin-password

# Hidden public entry point for the admin area (e.g. "admin" → /admin).
# While set, /auth/admin and /admin return 404. Required.
ADMIN_PATH=admin

# =============================================================================
# Tenant
# =============================================================================

# Host:port serving the landing page and admin panel (e.g. localhost:3030).
# Must match the PORT the dev server listens on. Required.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3030

# =============================================================================
# Rate Limiting / KV Store
# =============================================================================

# Upstash Redis REST API URL. Optional — only needed when not using MySQL
# as the KV store. Set together with KV_REST_API_TOKEN.
KV_REST_API_URL=https://your-upstash-redis.upstash.io

# Upstash REST API token. Optional — only needed with KV_REST_API_URL.
KV_REST_API_TOKEN=your-upstash-api-token

# Path to the local dev KV file. Optional — defaults to .dev-store.json.
LOCAL_KV_FILE=.dev-store.json

# =============================================================================
# SAM / AI
# =============================================================================

# OpenRouter API key for the SAM chatbot. Optional (at least one of
# OPENROUTER_API_KEY / CHATGPT_API_KEY is needed for SAM to work).
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# ChatGPT (OpenAI-compatible) API key for SAM fallback. Optional.
CHATGPT_API_KEY=sk-your-openai-key

# Default LLM model for SAM. Optional — defaults to a free OpenRouter model.
SAM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# =============================================================================
# Email / Notifications
# =============================================================================

# SMTP host for outgoing email. Optional — only needed when email transport
# is wired up.
SMTP_HOST=smtp.example.com

# SMTP port. Optional.
SMTP_PORT=587

# SMTP username. Optional.
SMTP_USER=your-smtp-user

# SMTP password. Optional.
SMTP_PASS=your-smtp-password

# From address for outgoing email. Optional.
SMTP_FROM=noreply@citgroup.example

# From name for outgoing email. Optional.
SMTP_FROM_NAME=CitGroup Tenancy

# Resend API key (alternative to SMTP). Optional.
RESEND_API_KEY=re_your-resend-key

# From email when using Resend. Optional.
RESEND_FROM_EMAIL=noreply@citgroup.example

# =============================================================================
# Site Configuration
# =============================================================================

# Node environment: development, production, or test. Optional — defaults
# to development.
NODE_ENV=development

# Colon-separated list of `name:secret` machine keys for API authentication.
# Optional — the health endpoint is the only unauthenticated route.
API_KEYS=webhook-name:webhook-secret
